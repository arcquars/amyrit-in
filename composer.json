{
  "name": "amyr-it/siat-bolivia-client",
  "description": "Biblioteca de cliente PHP para la integración con el servicio de facturación SIAT de Impuestos Nacionales de Bolivia.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Angel Pedro D. Murillo Nava",
      "email": "arc.quars@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-soap": "*",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Amyrit\\SiatBoliviaClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Amyrit\\SiatBoliviaClient\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Amyrit\\SiatBoliviaClient\\Laravel\\SiatServiceProvider"
      ],
      "aliases": {
        "Siat": "Amyrit\\SiatBoliviaClient\\Laravel\\SiatFacade"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
